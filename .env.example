# ── Regno Architect Me — full stack (mirrors docs/references/deploy.md) ──
# Local dev / single-host deployment via Docker Compose.
# Copy to .env and fill in secrets.

# ── Domain & TLS ──────────────────────────────────────────────
DOMAIN=john.regno.ai
TLS_EMAIL=admin@regnocloud.com

# ── Databases ─────────────────────────────────────────────────
# No Mongo auth in the first deploy (firewall protects the box); harden later.
MONGO_URI=mongodb://mongo:27017/regno
MONGO_POOL_SIZE=50
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379

# ── API Keys (multi-provider gateway) ─────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# ── Email / SMTP (notifications) ──────────────────────────────
SMTP_HOST=mail.postale.io
SMTP_PORT=587
SMTP_USERNAME=admin@regnocloud.com
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=admin@regnocloud.com
SMTP_FROM_NAME=Regno Cloud Admin

# ── GitHub (org seeding) ──────────────────────────────────────
GITHUB_ORG=regno-platform
GITHUB_TOKEN=

# ── Cloudflare DNS (provisioning) ─────────────────────────────
CF_API_TOKEN=
CF_ZONE_ID=
# REGNO_ROOT_DOMAIN=regno.ai   (default; subdomain = architect name)
# SERVER_IP=                   (public IP of the target machine)

# ── Mothership telemetry ──────────────────────────────────────
# Public URL of the Mothership control plane. Provisioned Architects POST their
# Regno Standard heartbeat to {MOTHERSHIP_URL}/api/architects/{slug}/telemetry.
MOTHERSHIP_URL=

# ── Identity / SSO (sysadmin parity) ──────────────────────────
# Regno Identity service — the same SSO provider as sysadmin.regnocloud.com
REGNO_IDENTITY_BASE_URL=https://identity.regnocloud.com

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-string-here

# ── Optional ──────────────────────────────────────────────────
ALLOWED_ORIGINS=https://john.regno.ai
AUDIT_TSA_URL=
